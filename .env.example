# 天择教育官网 · 服务端配置示例
# ------------------------------------------------------------
# 这个文件只被 server/ai-proxy.mjs 在 Node 侧读取，不会进前端产物；
# 填了真 key 的版本绝对不要提交到仓库、不要贴进聊天与文档。
#
# 用法：复制成 .env 并填入 key，然后 npm run dev 就能用在线模式。
# 不填 key 也能跑：前端会自动降级到内置教案的「离线演示」，界面不报错。

# 通义千问 API Key（也接受别名 DASHSCOPE_API_KEY）
QWEN_API_KEY=

# 模型 id。以阿里云百炼控制台里「模型列表」的实际 id 为准，实测可用：
#   qwen3.8-flash / qwen-flash / qwen-turbo / qwen-max（qwen-plus 在部分工作区 key 上连不通）
# 改这一行就能换模型，前端代码里没有任何模型名。
QWEN_MODEL=qwen3.8-flash

# 带思考的模型默认先推 2000+ token 再答题：实测生成一堂课 59.5s，
# 关掉思考 17.8s —— 演示现场等不起，所以默认关。想换推导深度就改 true。
# （不支持这个参数的模型会被服务端自动摘掉重试，不会报错）
QWEN_ENABLE_THINKING=false

# OpenAI 兼容模式端点。国内站默认即可；国际站换成 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 独立进程模式（node server/ai-proxy.mjs）的端口，仅绑 127.0.0.1
PORT=8787

# 置 1 强制视为未配 key，用来验证 AI 的离线降级通路
QWEN_OFFLINE=

# ===== 管理后台（/api/ai/admin/*）=====
# 会话签名密钥（必填才启用后台）。用一段足够长且随机的字符串，切勿提交：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# 首次启动时用它建一个 owner 账号；users.json 已有任意用户后这两项即被忽略。
# 未配置则后台启用但没有可登录的账号——请配置后重启。
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 生产（Nginx TLS + 反代）在进程环境里置 1，给会话 cookie 加 Secure；
# 本地 dev/preview 是 http，切勿置 1，否则浏览器不回传 cookie、登录即失效。
AUTH_COOKIE_SECURE=

# ===== 数据存储位置（可选）=====
# 集合根目录（users.json / content.json / leads.jsonl），默认 server/data/。
# ADMIN_DATA_DIR=
# 线索文件单独覆盖（默认 <ADMIN_DATA_DIR>/leads.jsonl）。
# LEADS_FILE=
